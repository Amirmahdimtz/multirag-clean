# Docker Compose
COMPOSE_PROJECT_NAME=multirag
MULTIRAG_APP_IMAGE=multirag-clean:production
MULTIRAG_PUBLIC_PORT=2011

# PostgreSQL / pgvector
PGVECTOR_IMAGE=pgvector/pgvector:0.8.5-pg16-bookworm
POSTGRES_DB=multirag
POSTGRES_USER=multirag
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
# URL-encode special characters in the password used in this URL.
MULTIRAG_DATABASE_URL=postgresql+asyncpg://multirag:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/multirag
MULTIRAG_DATABASE_ECHO_SQL=false
MULTIRAG_DATABASE_POOL_SIZE=10
MULTIRAG_DATABASE_MAX_OVERFLOW=20
MULTIRAG_DATABASE_POOL_PRE_PING=true
MULTIRAG_DATABASE_POOL_RECYCLE_SECONDS=1800

# MultiRAG API authentication
MULTIRAG_SECURITY_ENABLED=true
MULTIRAG_ADMIN_API_KEYS=["CHANGE_ME_ADMIN_API_KEY"]
MULTIRAG_USER_API_KEYS=[{"api_key":"CHANGE_ME_USER_API_KEY","user_id":"00000000-0000-0000-0000-000000000000"}]

# vLLM profile for one NVIDIA A100-SXM4 40GB.
# After the first successful pull/test, replace the tag with its immutable digest.
VLLM_IMAGE=vllm/vllm-openai:gemma4
VLLM_MODEL=google/gemma-4-31B-it-qat-w4a16-ct
VLLM_SERVED_MODEL_NAME=gemma4-31b
VLLM_API_KEY=CHANGE_ME_USE_A_LONG_RANDOM_VLLM_KEY
# Accept the Gemma terms on Hugging Face, then insert a read-only token.
HF_TOKEN=CHANGE_ME_HUGGING_FACE_READ_TOKEN
VLLM_DTYPE=auto
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=16384
VLLM_SHM_SIZE=16gb
# The official Gemma 4 vLLM image uses CUDA 12.9; enable compatibility for driver 550.
VLLM_ENABLE_CUDA_COMPATIBILITY=1

# Generation settings used by the FastAPI vLLM client
MULTIRAG_LLM_TEMPERATURE=1.0
MULTIRAG_LLM_MAX_TOKENS=1024
MULTIRAG_LLM_TOP_P=0.95
MULTIRAG_LLM_TOP_K=64
MULTIRAG_LLM_TIMEOUT_SECONDS=180

# Embedding runs inside the FastAPI container on CPU.
MULTIRAG_EMBEDDING_PROVIDER=jina
MULTIRAG_EMBEDDING_MODEL=jinaai/jina-embeddings-v3
MULTIRAG_EMBEDDING_VECTOR_SIZE=1024
MULTIRAG_EMBEDDING_DEVICE=cpu
MULTIRAG_EMBEDDING_OFFLINE=false
MULTIRAG_EMBEDDING_LOCAL_PATH=null
MULTIRAG_EMBEDDING_NORMALIZE=false

# PGVector and RAG
MULTIRAG_VECTOR_STORE_PROVIDER=pgvector
MULTIRAG_PGVECTOR_TABLE_PREFIX=multirag_dataset
MULTIRAG_PGVECTOR_VECTOR_SIZE=1024
MULTIRAG_PGVECTOR_BATCH_SIZE=10
MULTIRAG_PGVECTOR_HNSW_ENABLED=true
MULTIRAG_RAG_K_RETRIEVAL=5
MULTIRAG_RAG_SCORE_THRESHOLD=0.5

# Files and document processing
MULTIRAG_UPLOAD_MAX_FILE_SIZE_MB=50
MULTIRAG_UPLOAD_ALLOWED_EXTENSIONS=["pdf","docx","txt","csv"]
MULTIRAG_CHUNK_SIZE=1000
MULTIRAG_CHUNK_OVERLAP=150
